# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Python virtual environments & env files
.env
.env.*
.venv/
venv/
ENV/
env/

# Backend runtime artifacts
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/logs/
backend/memory/*.json
backend/__pycache__/

